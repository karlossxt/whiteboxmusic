rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthorized() {
      return request.auth != null
        && request.auth.uid == 'qtguil5JI0ejOeJ0fpiXrxTJvIq2';
    }

    /* Historias: publico solo status == 'published' (sin borradores), admin todo */
    match /stories/{storyId} {
      allow read: if isAuthorized() || resource.data.status == 'published';
      allow create, update, delete: if isAuthorized();
    }

    /* Contenido del sitio (CMS): lectura pública, escritura solo admin */
    match /site_content/{pageId} {
      allow read: if true;
      allow create, update, delete: if isAuthorized();
    }

    /* Galería fotográfica: lectura pública, escritura solo admin */
    match /gallery/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAuthorized();
    }

    /* Soundscapes (paisajes sonoros): solo publicadas para el sitio, admin todo */
    match /soundscapes/{soundscapeId} {
      allow read: if isAuthorized() || resource.data.published == true;
      allow create, update, delete: if isAuthorized();
    }

    /* Entrevistas: publico solo published == true (sin borradores), admin todo */
    match /interviews/{interviewId} {
      allow read: if isAuthorized() || resource.data.published == true;
      allow create, update, delete: if isAuthorized();
    }

    /* Configuración del sitio: lectura pública, escritura solo admin */
    match /site_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAuthorized();
    }
  }
}
